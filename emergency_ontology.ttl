@prefix :     <http://example.org/emergency#> .
@prefix нс:   <http://example.org/emergency#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.org/emergency> .

<http://example.org/emergency> a owl:Ontology ;
    rdfs:label "Онтологія управління надзвичайними ситуаціями (EM-DAT 2023)"@uk ;
    rdfs:comment "Лабораторна робота 7: формалізація ПдО. Дані: EM-DAT, записи за 2023 рік."@uk .

#################################################################
# Термінологічна частина (TBox): класи
#################################################################
:НадзвичайнаПодія a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :відбуваєтьсяВ ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Країна ] ,
                     [ a owl:Restriction ; owl:onProperty :маєРівеньТяжкості ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:comment "Подія, що спричинила людські жертви, збитки або потребувала реагування (запис EM-DAT)."@uk ;
    rdfs:label "Надзвичайна подія"@uk .

:ПриродняКатастрофа a owl:Class ;
    rdfs:subClassOf :НадзвичайнаПодія ;
    rdfs:comment "Подія природного походження (група катастроф «Природні» в EM-DAT)."@uk ;
    rdfs:label "Природна катастрофа"@uk .

:ТехногенняКатастрофа a owl:Class ;
    rdfs:subClassOf :НадзвичайнаПодія ;
    rdfs:comment "Подія техногенного походження (група катастроф «Техногенні» в EM-DAT)."@uk ;
    rdfs:label "Техногенна катастрофа"@uk .

:Повінь a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Повінь"@uk .

:Землетрус a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :магнітуда ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Землетрус"@uk .

:Шторм a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Шторм / тропічний циклон"@uk .

:ЛісоваПожежа a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Лісова пожежа"@uk .

:Епідемія a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Епідемія"@uk .

:Посуха a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Посуха"@uk .

:ЕкстремальнаТемпература a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Екстремальна температура"@uk .

:Зсув a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Зсув / селевий потік"@uk .

:ВивержуванняВулкана a owl:Class ;
    rdfs:subClassOf :ПриродняКатастрофа ;
    rdfs:label "Виверження вулкана"@uk .

:ТранспортнаАварія a owl:Class ;
    rdfs:subClassOf :ТехногенняКатастрофа ;
    rdfs:label "Транспортна аварія"@uk .

:ПромисловаАварія a owl:Class ;
    rdfs:subClassOf :ТехногенняКатастрофа ;
    rdfs:label "Промислова аварія"@uk .

:ІншаАварія a owl:Class ;
    rdfs:subClassOf :ТехногенняКатастрофа ;
    rdfs:label "Інша техногенна аварія"@uk .

:АвтомобільнаАварія a owl:Class ;
    rdfs:subClassOf :ТранспортнаАварія ;
    rdfs:label "Автомобільна аварія"@uk .

:ЗалізничнаАварія a owl:Class ;
    rdfs:subClassOf :ТранспортнаАварія ;
    rdfs:label "Залізнична аварія"@uk .

:АвіаційнаКатастрофа a owl:Class ;
    rdfs:subClassOf :ТранспортнаАварія ;
    rdfs:label "Авіаційна катастрофа"@uk .

:АваріяНаВоді a owl:Class ;
    rdfs:subClassOf :ТранспортнаАварія ;
    rdfs:label "Аварія на воді"@uk .

:ГрупаПодій a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :міститьПодію ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass :НадзвичайнаПодія ] ;
    rdfs:comment "Об'єднує записи EM-DAT однієї події, що охопила кілька країн."@uk ;
    rdfs:label "Група подій"@uk .

:Країна a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :розташованаВРегіоні ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Регіон ] ;
    rdfs:label "Країна"@uk .

:Регіон a owl:Class ;
    rdfs:label "Регіон світу"@uk .

:РівеньТяжкості a owl:Class ;
    rdfs:comment "Високий: ≥1000 загиблих, або ≥5 млн постраждалих, або збитки ≥5 млрд USD. Середній: ≥100 загиблих, або ≥100 тис. постраждалих, або збитки ≥100 млн USD. Інакше — низький."@uk ;
    rdfs:label "Рівень тяжкості"@uk .

:СценарійРеагування a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :маєКрок ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :КрокСценарію ] ,
                     [ a owl:Restriction ; owl:onProperty :залучаєСлужбу ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :СлужбаРеагування ] ;
    rdfs:comment "Типовий порядок дій служб у відповідь на подію."@uk ;
    rdfs:label "Сценарій реагування"@uk .

:СценарійЕвакуації a owl:Class ;
    rdfs:subClassOf :СценарійРеагування ;
    rdfs:label "Сценарій евакуації"@uk .

:ПошуковоРятувальнийСценарій a owl:Class ;
    rdfs:subClassOf :СценарійРеагування ;
    rdfs:label "Пошуково-рятувальний сценарій"@uk .

:МедичнийСценарій a owl:Class ;
    rdfs:subClassOf :СценарійРеагування ;
    rdfs:label "Медичний сценарій"@uk .

:СценарійГасінняПожеж a owl:Class ;
    rdfs:subClassOf :СценарійРеагування ;
    rdfs:label "Сценарій гасіння пожеж"@uk .

:КрокСценарію a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :єКрокомСценарію ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :СценарійРеагування ] ;
    rdfs:label "Крок сценарію"@uk .

:СлужбаРеагування a owl:Class ;
    rdfs:label "Служба реагування"@uk .

# Діз'юнктність несумісних класів
[] a owl:AllDisjointClasses ; owl:members ( :ПриродняКатастрофа :ТехногенняКатастрофа ) .
[] a owl:AllDisjointClasses ; owl:members ( :Повінь :Землетрус :Шторм :ЛісоваПожежа :Епідемія :Посуха :ЕкстремальнаТемпература :Зсув :ВивержуванняВулкана ) .
[] a owl:AllDisjointClasses ; owl:members ( :ТранспортнаАварія :ПромисловаАварія :ІншаАварія ) .
[] a owl:AllDisjointClasses ; owl:members ( :АвтомобільнаАварія :ЗалізничнаАварія :АвіаційнаКатастрофа :АваріяНаВоді ) .
[] a owl:AllDisjointClasses ; owl:members ( :СценарійЕвакуації :ПошуковоРятувальнийСценарій :МедичнийСценарій :СценарійГасінняПожеж ) .
[] a owl:AllDisjointClasses ; owl:members ( :НадзвичайнаПодія :ГрупаПодій :Країна :Регіон :РівеньТяжкості :СценарійРеагування :КрокСценарію :СлужбаРеагування ) .

#################################################################
# Термінологічна частина (TBox): об'єктні властивості
#################################################################
:відбуваєтьсяВ a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range :Країна ; rdfs:label "відбулася в країні"@uk .
:розташованаВРегіоні a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Країна ; rdfs:range :Регіон ; rdfs:label "розташована в регіоні"@uk .
:маєРівеньТяжкості a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range :РівеньТяжкості ; rdfs:label "має рівень тяжкості"@uk .
:застосованоДляРеагуванняНа a owl:ObjectProperty ; rdfs:domain :СценарійРеагування ; rdfs:range :НадзвичайнаПодія ; owl:inverseOf :реагуванняЗаСценарієм ; rdfs:label "застосовувався у відповідь на"@uk .
:реагуванняЗаСценарієм a owl:ObjectProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range :СценарійРеагування ; rdfs:label "реагування за сценарієм"@uk .
:входитьДоГрупи a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range :ГрупаПодій ; owl:inverseOf :міститьПодію ; rdfs:label "входить до групи подій"@uk .
:міститьПодію a owl:ObjectProperty ; rdfs:domain :ГрупаПодій ; rdfs:range :НадзвичайнаПодія ; rdfs:label "містить подію"@uk .
:залучаєСлужбу a owl:ObjectProperty ; rdfs:domain :СценарійРеагування ; rdfs:range :СлужбаРеагування ; rdfs:label "залучає службу"@uk .
:маєКрок a owl:ObjectProperty ; rdfs:domain :СценарійРеагування ; rdfs:range :КрокСценарію ; owl:inverseOf :єКрокомСценарію ; rdfs:label "має крок"@uk .
:єКрокомСценарію a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :КрокСценарію ; rdfs:range :СценарійРеагування ; rdfs:label "є кроком сценарію"@uk .

#################################################################
# Термінологічна частина (TBox): датні властивості
#################################################################
:кодПодії a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:string ; rdfs:label "код події EM-DAT"@uk .
:типЗаEMDAT a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:string ; rdfs:label "тип події за EM-DAT"@uk .
:місяцьПочатку a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:integer ; rdfs:label "місяць початку"@uk .
:кількістьЗагиблих a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:nonNegativeInteger ; rdfs:label "кількість загиблих"@uk .
:кількістьПостраждалих a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:nonNegativeInteger ; rdfs:label "кількість постраждалих"@uk .
:збиткиТисUSD a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:decimal ; rdfs:label "збитки, тис. USD"@uk .
:маєОголошенняНС a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:boolean ; rdfs:label "оголошено надзвичайний стан"@uk .
:маєМіжнародніЗвернення a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :НадзвичайнаПодія ; rdfs:range xsd:boolean ; rdfs:label "міжнародне звернення по допомогу"@uk .
:магнітуда a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Землетрус ; rdfs:range xsd:decimal ; rdfs:label "магнітуда (Ріхтера)"@uk .
:кодISO a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Країна ; rdfs:range xsd:string ; rdfs:label "ISO-код країни"@uk .
:номерКроку a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :КрокСценарію ; rdfs:range xsd:integer ; rdfs:label "номер кроку"@uk .
:текстКроку a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :КрокСценарію ; rdfs:range xsd:string ; rdfs:label "опис кроку"@uk .

#################################################################
# Частина з екземплярами (ABox): події, країни, регіони, сценарії
#################################################################
:Регіон_Азія a :Регіон ; rdfs:label "Азія"@uk .
:Регіон_Африка a :Регіон ; rdfs:label "Африка"@uk .
:Регіон_Америка a :Регіон ; rdfs:label "Америка"@uk .

:Країна_AFG a :Країна ; rdfs:label "Афганістан"@uk ; :кодISO "AFG" ; :розташованаВРегіоні :Регіон_Азія .
:Країна_CHN a :Країна ; rdfs:label "Китай"@uk ; :кодISO "CHN" ; :розташованаВРегіоні :Регіон_Азія .
:Країна_COD a :Країна ; rdfs:label "Конго – Кіншаса"@uk ; :кодISO "COD" ; :розташованаВРегіоні :Регіон_Африка .
:Країна_IND a :Країна ; rdfs:label "Індія"@uk ; :кодISO "IND" ; :розташованаВРегіоні :Регіон_Азія .
:Країна_LBY a :Країна ; rdfs:label "Лівія"@uk ; :кодISO "LBY" ; :розташованаВРегіоні :Регіон_Африка .
:Країна_MAR a :Країна ; rdfs:label "Марокко"@uk ; :кодISO "MAR" ; :розташованаВРегіоні :Регіон_Африка .
:Країна_MOZ a :Країна ; rdfs:label "Мозамбік"@uk ; :кодISO "MOZ" ; :розташованаВРегіоні :Регіон_Африка .
:Країна_MWI a :Країна ; rdfs:label "Малаві"@uk ; :кодISO "MWI" ; :розташованаВРегіоні :Регіон_Африка .
:Країна_NGA a :Країна ; rdfs:label "Нігерія"@uk ; :кодISO "NGA" ; :розташованаВРегіоні :Регіон_Африка .
:Країна_NPL a :Країна ; rdfs:label "Непал"@uk ; :кодISO "NPL" ; :розташованаВРегіоні :Регіон_Азія .
:Країна_PER a :Країна ; rdfs:label "Перу"@uk ; :кодISO "PER" ; :розташованаВРегіоні :Регіон_Америка .
:Країна_SYR a :Країна ; rdfs:label "Сирія"@uk ; :кодISO "SYR" ; :розташованаВРегіоні :Регіон_Азія .
:Країна_TUR a :Країна ; rdfs:label "Туреччина"@uk ; :кодISO "TUR" ; :розташованаВРегіоні :Регіон_Азія .
:Країна_USA a :Країна ; rdfs:label "Сполучені Штати"@uk ; :кодISO "USA" ; :розташованаВРегіоні :Регіон_Америка .

:Тяжкість_Високий a :РівеньТяжкості ; rdfs:label "Високий"@uk .
:Тяжкість_Середній a :РівеньТяжкості ; rdfs:label "Середній"@uk .
:Тяжкість_Низький a :РівеньТяжкості ; rdfs:label "Низький"@uk .

:Служба_Рятувальна a :СлужбаРеагування ; rdfs:label "Рятувальна служба"@uk .
:Служба_Медична a :СлужбаРеагування ; rdfs:label "Медична служба"@uk .
:Служба_Пожежна a :СлужбаРеагування ; rdfs:label "Пожежна служба"@uk .
:Служба_КоординаційнийШтаб a :СлужбаРеагування ; rdfs:label "Координаційний штаб"@uk .
:Служба_ГромадськийПорядок a :СлужбаРеагування ; rdfs:label "Служба громадського порядку"@uk .

:Сценарій_МасоваЕвакуація a :СценарійЕвакуації ; rdfs:label "Масова евакуація населення"@uk ;
    :залучаєСлужбу :Служба_Рятувальна , :Служба_ГромадськийПорядок , :Служба_КоординаційнийШтаб ;
    :маєКрок :Крок_МасоваЕвакуація_1 , :Крок_МасоваЕвакуація_2 , :Крок_МасоваЕвакуація_3 .
:Крок_МасоваЕвакуація_1 a :КрокСценарію ; :номерКроку 1 ; :текстКроку "Оцінити загрозу та визначити зони евакуації"@uk ; rdfs:label "Масова евакуація населення: крок 1"@uk .
:Крок_МасоваЕвакуація_2 a :КрокСценарію ; :номерКроку 2 ; :текстКроку "Оповістити населення та організувати вивезення людей до безпечних пунктів"@uk ; rdfs:label "Масова евакуація населення: крок 2"@uk .
:Крок_МасоваЕвакуація_3 a :КрокСценарію ; :номерКроку 3 ; :текстКроку "Забезпечити тимчасове розміщення, харчування та облік евакуйованих"@uk ; rdfs:label "Масова евакуація населення: крок 3"@uk .

:Сценарій_ПошукНаЗавалах a :ПошуковоРятувальнийСценарій ; rdfs:label "Пошуково-рятувальні роботи на завалах"@uk ;
    :залучаєСлужбу :Служба_Рятувальна , :Служба_Медична , :Служба_КоординаційнийШтаб ;
    :маєКрок :Крок_ПошукНаЗавалах_1 , :Крок_ПошукНаЗавалах_2 , :Крок_ПошукНаЗавалах_3 .
:Крок_ПошукНаЗавалах_1 a :КрокСценарію ; :номерКроку 1 ; :текстКроку "Розгорнути рятувальні групи та оглянути зруйновані споруди"@uk ; rdfs:label "Пошуково-рятувальні роботи на завалах: крок 1"@uk .
:Крок_ПошукНаЗавалах_2 a :КрокСценарію ; :номерКроку 2 ; :текстКроку "Виконати пошук і деблокування постраждалих"@uk ; rdfs:label "Пошуково-рятувальні роботи на завалах: крок 2"@uk .
:Крок_ПошукНаЗавалах_3 a :КрокСценарію ; :номерКроку 3 ; :текстКроку "Надати першу медичну допомогу та евакуювати поранених"@uk ; rdfs:label "Пошуково-рятувальні роботи на завалах: крок 3"@uk .

:Сценарій_КонтрольЕпідемії a :МедичнийСценарій ; rdfs:label "Контроль спалаху епідемії"@uk ;
    :залучаєСлужбу :Служба_Медична , :Служба_КоординаційнийШтаб ;
    :маєКрок :Крок_КонтрольЕпідемії_1 , :Крок_КонтрольЕпідемії_2 , :Крок_КонтрольЕпідемії_3 .
:Крок_КонтрольЕпідемії_1 a :КрокСценарію ; :номерКроку 1 ; :текстКроку "Виявити та підтвердити спалах, провести епідеміологічне розслідування"@uk ; rdfs:label "Контроль спалаху епідемії: крок 1"@uk .
