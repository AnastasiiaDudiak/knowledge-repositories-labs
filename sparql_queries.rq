# Запит 1: KQ1 — найсмертоносніші події 2023 року
PREFIX нс:   <http://example.org/emergency#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?подія ?країна ?загиблі
WHERE {
  ?ев a/rdfs:subClassOf* нс:НадзвичайнаПодія ;
     rdfs:label ?подія ;
     нс:відбуваєтьсяВ ?кр ;
     нс:кількістьЗагиблих ?загиблі .
  ?кр rdfs:label ?країна .
}
ORDER BY DESC(?загиблі)
LIMIT 5

# ----------------------------------------

# Запит 2: KQ2 — загиблі від природних катастроф за регіонами
PREFIX нс:   <http://example.org/emergency#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?регіон (COUNT(?ев) AS ?подій) (SUM(?зг) AS ?загиблих)
WHERE {
  ?ев a/rdfs:subClassOf* нс:ПриродняКатастрофа ;
     нс:відбуваєтьсяВ ?кр ;
     нс:кількістьЗагиблих ?зг .
  ?кр нс:розташованаВРегіоні ?рг .
  ?рг rdfs:label ?регіон .
}
GROUP BY ?регіон
ORDER BY DESC(?загиблих)

# ----------------------------------------

# Запит 3: KQ3 — події високої тяжкості та сценарії реагування
PREFIX нс:   <http://example.org/emergency#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?подія ?сценарій
WHERE {
  ?ев нс:маєРівеньТяжкості нс:Тяжкість_Високий ;
     rdfs:label ?подія .
  ?сц нс:застосованоДляРеагуванняНа ?ев ;
     rdfs:label ?сценарій .
}
ORDER BY ?подія

# ----------------------------------------

# Запит 4: KQ4 — масштабні події без міжнародного звернення по допомогу
PREFIX нс:   <http://example.org/emergency#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?подія ?постраждалі
WHERE {
  ?ев rdfs:label ?подія ;
     нс:кількістьПостраждалих ?постраждалі ;
     нс:маєМіжнародніЗвернення false .
  FILTER (?постраждалі > 1000000)
}
ORDER BY DESC(?постраждалі)

# ----------------------------------------

# Запит 5: Додатково — перевірка правила рівня тяжкості (очікується порожній результат: розбіжностей немає)
PREFIX нс:   <http://example.org/emergency#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?подія ?рівень
WHERE {
  ?ев a/rdfs:subClassOf* нс:НадзвичайнаПодія ;
     rdfs:label ?подія ;
     нс:маєРівеньТяжкості ?рв .
  ?рв rdfs:label ?рівень .
  OPTIONAL { ?ев нс:кількістьЗагиблих ?зг }
  OPTIONAL { ?ев нс:кількістьПостраждалих ?пс }
  OPTIONAL { ?ев нс:збиткиТисUSD ?зб }
  BIND(COALESCE(?зг, 0) AS ?ЗГ)
  BIND(COALESCE(?пс, 0) AS ?ПС)
  BIND(COALESCE(?зб, 0) AS ?ЗБ)
  BIND(IF(?ЗГ >= 1000 || ?ПС >= 5000000 || ?ЗБ >= 5000000, нс:Тяжкість_Високий,
       IF(?ЗГ >= 100 || ?ПС >= 100000 || ?ЗБ >= 100000, нс:Тяжкість_Середній, нс:Тяжкість_Низький)) AS ?правило)
  FILTER (?рв != ?правило)
}
